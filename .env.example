# --- GitHub (fuente de datos) ---
GITHUB_REPO=dbt-labs/docs.getdbt.com
GITHUB_BRANCH=current
GITHUB_DOCS_PATH=website/docs/docs
# Opcional pero MUY recomendado: sin token la API de GitHub limita a 60 req/h.
# Generá uno (sin permisos especiales) en https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Embeddings ---
# local  -> gratis, corre en tu máquina (sentence-transformers)
# openai -> requiere OPENAI_API_KEY
# voyage -> requiere VOYAGE_API_KEY
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- LLM de generación ---
# anthropic -> requiere ANTHROPIC_API_KEY
# openai    -> requiere OPENAI_API_KEY
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Retrieval ---
TOP_K=5

# --- Solo relevante para deploys en la nube con disco efímero (ej. Streamlit
# Community Cloud): si el índice está vacío al arrancar, la app se
# auto-indexa. Este límite acota cuántos documentos indexa en ese primer
# arranque (para no hacer esperar minutos al primer visitante). Vacío =
# corpus completo. En local no hace falta tocarlo.
STARTUP_INDEX_LIMIT=150

# --- Base de datos vectorial (Chroma, embebido: no requiere Docker ni servidor) ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=dbt_doc_chunks
